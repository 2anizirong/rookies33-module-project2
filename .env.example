# =============================================
# .env.example
# 실제 값을 채운 뒤 파일명을 .env 로 바꾸세요.
# .env 는 절대 git에 커밋하지 않습니다.
# =============================================

# OpenAI API 키 (ai_judge.py 에서 사용)
OPENAI_API_KEY=sk-...

# Flask 취약 웹 서버 설정 (web/app.py)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Mock IMDS 서버 주소 (로컬 테스트 단계)
# AWS 배포 단계에서는 http://169.254.169.254 로 변경
IMDS_BASE_URL=http://127.0.0.1:5001

# AWS 설정 (aws 배포 단계에서 채울 것 - 로컬 mock 단계에서는 불필요)
# 실제 IAM 자격증명은 여기에 직접 넣지 말고 EC2 인스턴스 프로파일로 처리하세요.
AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=         # 로컬 boto3 테스트 시에만 임시로 사용
# AWS_SECRET_ACCESS_KEY=     # 로컬 boto3 테스트 시에만 임시로 사용